# ---------------------------------------------------------------------------
# Safe Arrival CPT. Copy to .env.local. Placeholders only; never commit real keys.
# Leave everything blank to run the full demo on the in-browser database.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). The ANON key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: your WhatsApp Business number, digits only (e.g. 27210000000).
# When set, QR codes and hotel links open real WhatsApp instead of the simulator.
VITE_WHATSAPP_NUMBER=

# NEVER put the service_role key or any WhatsApp secret in a VITE_ variable:
# everything prefixed VITE_ is bundled into public JavaScript.
# Server-side secrets belong in Supabase Edge Function secrets (see README):
#   SUPABASE_SERVICE_ROLE_KEY, WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
#   WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN, DISPATCH_SECRET, PUBLIC_APP_URL
