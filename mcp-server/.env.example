# SafeArrival MCP server. Copy to .env (local) and set the same in the Vercel project.
# The ANON key only: the server never uses the service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# At least 32 random characters. Register its hash once in the database (SQL editor):
#   select private.set_mcp_secret('<the same value>');
MCP_SERVER_SECRET=
